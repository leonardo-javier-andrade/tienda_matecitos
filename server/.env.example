# ===========================================
# Tienda Matecitos - Variables de Entorno
# ===========================================
# Copia este archivo como .env y completá los valores

# URI de conexión a MongoDB Atlas (reemplazar con tu URI)
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/tienda-matecitos?retryWrites=true&w=majority

# Puerto del servidor (Render asigna el suyo automáticamente)
PORT=5000

# URL del frontend (para configurar CORS en producción)
CLIENT_URL=http://localhost:5173
