# ===========================================
# Tienda Matecitos - Variables de Entorno
# ===========================================
# Copia este archivo como .env y completá los valores

# URI de conexión a MongoDB Atlas (reemplazar con tu URI)
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/tienda-matecitos?retryWrites=true&w=majority

# Puerto del servidor (Render asigna el suyo automáticamente)
PORT=5000

# URL del frontend (para configurar CORS en producción)
CLIENT_URL=http://localhost:5173

# ─── Cloudinary (para subida de imágenes y videos) ───
# Crear cuenta gratuita en https://cloudinary.com
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ─── Autenticación Admin ─────────────────────────────
# Clave secreta para firmar tokens JWT (usar una cadena larga y aleatoria)
JWT_SECRET=cambiar_por_una_clave_secreta_segura_muy_larga

# Contraseña del administrador (para acceder al dashboard)
ADMIN_PASSWORD=tu_contraseña_admin
